---
import Sprig from './Sprig.astro';
import { projects, asset, type Project } from '../data/site';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
const groups: { label: string; tier: 'featured' | 'earlier'; items: Project[] }[] = [
  { label: 'Selected work', tier: 'featured', items: featured },
  { label: featured.length ? 'More projects' : 'Projects', tier: 'earlier', items: others },
].filter((g) => g.items.length);
const pad = (n: number) => String(n).padStart(2, '0');
let counter = 0;
---

{projects.length > 0 && (
<section id="work" class="section on-light edge-grass" aria-labelledby="work-h">
  <div class="wrap">
    <p class="mono muted eyebrow reveal"><Sprig />Work</p>
    <h2 id="work-h" class="serif reveal">Projects and studies.</h2>

    {
      groups.map((g) => (
        <div class={`group ${g.tier}`}>
          <h3 class="mono muted">{g.label}</h3>
          <ol>
            {g.items.map((p) => (
              <li class="reveal">
                <hr class="rule" />
                <article class="row">
                  <div class="plate-motif">
                    <div class={`frame ${p.cover ? 'has-cover' : ''}`}>
                      {p.cover ? <img src={asset(p.cover)} alt={`${p.title}`} loading="lazy" /> : <span class="blank" aria-hidden="true">{p.category}</span>}
                    </div>
                    <span class="mono idx">{pad(++counter)}</span>
                  </div>
                  <div class="main">
                    <h4 class="serif">{p.title}</h4>
                    <p class="mono muted kicker">{[p.category, p.location, p.date && p.date.slice(0, 4)].filter(Boolean).join(' · ')}</p>
                    <p class="sum">{p.summary}</p>
                    {p.highlights.length > 0 && (
                      <ul class="hl">
                        {p.highlights.map((h) => <li>{h}</li>)}
                      </ul>
                    )}
                    {p.tools.length > 0 && (
                      <ul class="mono tags" aria-label={`${p.title} tools`}>
                        {p.tools.map((s) => <li>{s}</li>)}
                      </ul>
                    )}
                  </div>
                  {(p.html || p.gallery.length > 0) && (
                    <div class="figs">
                      <details class="fig">
                        <summary class="mono">
                          <span class="fig-label">Read more</span>
                          <span class="fig-toggle" aria-hidden="true" />
                        </summary>
                        <div class="more">
                          {p.html && <div class="prose" set:html={p.html} />}
                          {p.gallery.length > 0 && (
                            <div class="gallery">
                              {p.gallery.map((g) => <img src={asset(g)} alt="" loading="lazy" />)}
                            </div>
                          )}
                        </div>
                      </details>
                    </div>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
)}

<style>
  h2 {
    margin: 1.5rem 0 4rem;
    font-size: clamp(2rem, 4.6vw, 3.75rem);
  }
  .group {
    margin-bottom: 6rem;
  }
  .group h3 {
    margin: 0 0 1.5rem;
    font-weight: 400;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.25rem 2.75rem;
    grid-template-columns: minmax(0, 1fr);
  }

  /* an arched window onto a small drawing of the natural world */
  .plate-motif {
    position: relative;
    max-width: 15rem;
  }
  .frame {
    padding: 2.2rem 1.1rem 1.2rem;
    aspect-ratio: 4 / 5;
    display: grid;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    border-radius: 999px 999px 12px 12px;
    background:
      radial-gradient(ellipse 80% 55% at 50% 100%, rgb(212 165 58 / 0.3), transparent 72%),
      color-mix(in srgb, var(--paper-2) 70%, transparent);
    transition: transform 0.7s var(--ease), box-shadow 0.7s var(--ease);
  }
  .idx {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink-soft);
  }
  h4 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
  }
  .featured h4 {
    font-size: clamp(2.25rem, 5vw, 4rem);
  }
  .featured .row {
    padding-block: 3rem 3.75rem;
  }
  .kicker {
    margin: 0.75rem 0 1.5rem;
  }
  .quip-unused {
    margin: -0.9rem 0 1.4rem;
    font: italic 300 1.15rem/1.3 var(--serif);
    color: var(--ochre);
  }
  :global(:root[data-theme='night']) .quip {
    color: var(--straw);
  }
  .sum {
    margin: 0 0 0.85rem;
    max-width: 58ch;
  }
  .featured .sum:first-of-type {
    font-size: 1.125em;
  }

  /* stack: smooth pebbles, each a little different */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
  }
  .tags li {
    padding: 0.4rem 0.95rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--straw) 20%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 35%, transparent);
    border-radius: 58% 42% 52% 48% / 55% 50% 50% 45%;
    transition: transform 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  .tags li:nth-child(2n) {
    border-radius: 45% 55% 42% 58% / 50% 45% 55% 50%;
  }
  .tags li:nth-child(3n) {
    border-radius: 52% 48% 60% 40% / 45% 58% 42% 55%;
  }
  @media (hover: hover) {
    .tags li:hover {
      transform: translateY(-3px) rotate(-2deg);
      background: color-mix(in srgb, var(--straw) 38%, transparent);
    }
    .row:hover .frame {
      transform: translateY(-4px);
      box-shadow: 0 22px 36px -26px rgb(138 93 20 / 0.7);
    }
  }

  .figs {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  .fig,
  .fig {
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .fig summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3rem;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
  }
  .fig summary::-webkit-details-marker {
    display: none;
  }
  .fig-toggle::before {
    content: '+';
    font-size: 1.1rem;
  }
  .fig[open] .fig-toggle::before {
    content: '\2212';
  }
  .link {
    margin: 1.25rem 0 0;
    font-family: var(--mono);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  .link a {
    display: inline-block;
    padding-block: 0.5rem;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.35rem) / 100% 1px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .link a:hover,
  .link a:focus-visible {
    background-size: 0 1px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3rem;
    }
    .plate-motif {
      grid-column: 1;
      grid-row: 1;
    }
    .main {
      grid-column: 2;
      grid-row: 1;
    }
    .featured li:nth-child(even) .row {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
    .featured li:nth-child(even) .plate-motif {
      grid-column: 2;
    }
    .featured li:nth-child(even) .main {
      grid-column: 1;
    }
    .figs {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .earlier .plate-motif {
      max-width: 11rem;
    }
    .earlier .row {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px 999px 8px 8px;
  }
  .frame.has-cover {
    padding: 0.35rem;
  }
  .blank {
    text-align: center;
    font: italic 300 1.1rem/1.2 var(--serif);
    color: var(--ink-soft);
    padding-top: 1.5rem;
  }
  .hl {
    margin: 0 0 0.5rem;
    padding-left: 1.1rem;
    max-width: 58ch;
    color: var(--ink-soft);
  }
  .hl li {
    margin-bottom: 0.35rem;
  }
  .more {
    padding: 0.5rem 0 1.5rem;
    max-width: 62ch;
  }
  .more :global(p) {
    margin: 0 0 1rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    max-width: none;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
